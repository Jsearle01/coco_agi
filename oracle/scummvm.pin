# scummvm.pin — THE ORACLE PIN (CLAUDE.md §2Q)
#
# ★★ THIS PROJECT HAS NO SOURCE. Sierra's AGI interpreter source is not public. ScummVM is a
# REIMPLEMENTATION, reverse-engineered by people who did not have the source either (§2). It is
# the best secondary evidence available and it is what this project plans and diffs against —
# but per §2.1 it is not neutral: it fixes original bugs, works around game-specific quirks and
# normalises across interpreter versions. "ScummVM does it this way" is a fact about ScummVM.
#
# ★ §2Q requires BOTH halves of the oracle to be pinned. Half 1 is below and is settled.
# Half 2 — the game set — is NOT YET PINNED and is Jay's to supply. See [game-set].


[scummvm]

# ★★ v2.9.1 is an ANNOTATED TAG, so `git ls-remote` reports the TAG OBJECT's SHA and
# `git rev-parse HEAD` reports the COMMIT's. They are different values for the same pin and
# confusing them will look like drift. Both are recorded; THE COMMIT IS THE PIN.
commit      = 9d9b9e93108a276c551aeffa390169ccc5148e15
tag         = v2.9.1
tag_object  = 4f4258679fd50dac40ed86ad241ab295bb9ebfa6
verify      = git rev-parse v2.9.1^{commit}   # must print the commit above

# Why a release tag rather than a master commit: a tag is a named, reproducible reference that
# a second party can resolve without this file, and it is the state ScummVM itself calls
# shippable. A master SHA pins equally well but names nothing.

repository  = https://github.com/scummvm/scummvm.git


[clone]

# ★ TWO CLONES, ONE PIN (dispatch §5.2). The reading clone and the building clone are separate
# trees and MUST be at the same commit. Both recipes land at the commit above.
#
# Reading (this is the one the report's file:line citations were taken from):
#   git clone --depth 1 --branch v2.9.1 https://github.com/scummvm/scummvm.git scummvm
#
# ★ The startup prompt's sparse recipe (--filter=blob:none --sparse + sparse-checkout set
# engines/agi) reads fine and CANNOT BUILD — configure needs the full tree. Recorded so the
# next person does not try.
#
# Building: the same command. A full depth-1 checkout at the tag is ~21,430 files and builds.
#
# ★★ NOT VENDORED (§2Q.1). No ScummVM source is committed to coco_agi — a checked-in copy
# starts feeling like source, and §2 says there is none. This file plus oracle/patches/ is the
# whole record.


[build]

# ★★ HEADLESS, AGI-ONLY, NO SDL. --backend=null is not a convenience, it is a §2O.1 decision:
# the dumps come from the engine's own 160x168 buffers, and a build with no display backend
# cannot accidentally route a baseline through a scaler or a palette.
#
# It also removes the only hard blocker on this machine — there is no C++ toolchain on the
# Windows host at all and no SDL2 anywhere, so an SDL build was never available. See [host].

configure   = ./configure --backend=null --disable-all-engines --enable-engine=agi
build       = make -j2
binary      = ./scummvm

# Confirmed at the pin, in config.mk:
#   BACKEND := null
#   ENABLE_AGI = STATIC_PLUGIN        (every other engine commented out)


[host]

# Recorded because it determines WHERE the build happens, and a second party on this machine
# needs to know before trying.
#
# Windows host  : NO C++ toolchain. No gcc, g++, clang, MSVC, make, cmake or pkg-config; no
#                 MSYS2 and no MinGW compiler (the git on PATH is Git-for-Windows' mingw64
#                 bundle, which ships no compiler). No SDL2 anywhere.
# WSL2 Ubuntu   : g++ (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0, GNU Make 4.3, git, python3.
#                 2 CPUs. No SDL2 dev packages — hence --backend=null.
#
# ★ BUILD INSIDE WSL's ext4 (~/scummvm), NOT on /mnt/c. A 21,430-file build over the 9p mount
# is pathologically slow. The reading clone lives at C:\Projects\scummvm; the build clone at
# ~/scummvm inside WSL. Both at the commit above — verified, not assumed.


[patches]

# ★ INSTRUMENTATION IS PATCHES AGAINST THE PIN, NEVER A MODIFIED VENDORED TREE (§5.4).
# Reproducible from pin + patch or it is not pinned.
#
#   oracle/patches/0001-oracle-room-dump.patch      graphics.h, graphics.cpp, picture.cpp
#   oracle/patches/0002-oracle-vm-state-dump.patch  cycle.cpp
#   oracle/patches/0003-oracle-row24-probe-and-lzw-trace.patch   op_cmd.cpp, loader_v3.cpp
#   oracle/patches/0004-oracle-raw-resource-dump.patch           agi.cpp, op_cmd.cpp
#   oracle/patches/0005-oracle-deterministic-clock.patch         global.cpp, cycle.cpp
#
# ★ 0004 WAS ADDED AT P1.1 AND NOT RECORDED HERE UNTIL P4.1. Found by re-reading this file
# against the tree rather than trusting it. The list above is now checked against
# `ls oracle/patches/`, not maintained from memory.
#
# Apply from the clone root, IN ORDER (0005 was generated against pin+0001..0004, and its
# cycle.cpp hunk sits directly above 0002's -- out of order it will not apply):
#   git apply oracle/patches/0001-*.patch oracle/patches/0002-*.patch \
#             oracle/patches/0003-*.patch oracle/patches/0004-*.patch \
#             oracle/patches/0005-*.patch
# 0001-0004 total 136 inserted lines, 0 deleted. 0005 adds 38 and deletes 1 -- it is the ONLY
# patch that changes existing behaviour rather than purely adding instrumentation, and that is
# called out in [determinism] below.
#
# ★★ THE PATCH FILES MUST STAY LF. .gitattributes pins *.patch to eol=lf because `git apply`
# matches context BYTE FOR BYTE; a CRLF checkout fails on every hunk (measured at P0.2).
#
# ★ OUTPUT FILE NAMES, and one trap: ScummVM's Common::DumpFile writes atomically —
# backends/fs/stdiostream.cpp appends ".tmp" and renames on close. The picture dumps close
# explicitly and land as pic<NNN>.visual.bin / pic<NNN>.priority.bin. The long-lived logs
# (vmstate.txt, row24.txt) are never closed when the process is killed by `timeout`, so they
# remain as <name>.tmp and the runner renames them. A rename is not a transformation.


[game-set]

# ★★ PINNED AT P0.3. This half of the oracle is no longer blocked.

repository  = https://github.com/lanceewing/agile-gdx.git
commit      = 81c42ba63b3b7f5fb260d282592681c097d46da9
path        = html/webapp/games/*.zip
titles      = 150          (147 v2-shaped, 3 v3-shaped)
manifest    = games/manifests/agile-gdx-81c42ba.tsv
regenerate  = python harness/tools/game_manifest.py <corpus-dir> --out games/manifests/agile-gdx-81c42ba.tsv

# ★★ PINNING BY COMMIT DISSOLVES §2Q's PROBLEM RATHER THAN SOLVING IT.
# §2Q's objection is that *"King's Quest I" is not a specification* — a title names a family of
# releases with different interpreter versions and different command sets [AGI Specs §3.9-3.10].
# A COMMIT SHA names an exact set of exact bytes. The whole corpus moves as one pinned unit, and
# every per-title sha256 is in the manifest above, so identification is per-file and exact.
#
# Maintained by Lance Ewing, who authored much of the AGI Specifications this design cites.

# Reading recipe (blobless + sparse; the corpus is 19 MB of the repo):
#   git clone --filter=blob:none --no-checkout https://github.com/lanceewing/agile-gdx.git
#   cd agile-gdx && git sparse-checkout init --cone
#   git sparse-checkout set html/webapp/games && git checkout 81c42ba
#
# ★★ GAME DATA LIVES OUTSIDE coco_agi AND ALWAYS WILL (§2P). Corpus at C:\Projects\agi-games\;
# unpacked working copies at ~/agi-work/games/ inside WSL. The repository holds MANIFESTS ONLY.
# Archives are opened 'r' and never written back.

# ★ v3 IS EXERCISED, NOT MERELY PRESENT. kq4dem is detected by the pinned ScummVM as
#   "agi:kq4  King's Quest IV: The Perils of Rosella (Demo 1988-12-20/DOS/English)"
# — real Sierra v3 data, freely distributed — and its resources are LZW-EXPANDED at
# loader_v3.cpp:175, confirmed by the trace in patch 0003. That matters because design §9 ranks
# v3 LZW second and AD-12 puts it on the target's critical path: the 6809 must handle these
# bytes, so host-side decompression is not an option.
#
# The other two v3-shaped titles are demo3 and vtgadv.

[determinism]

# ★★ ESTABLISHED AT P4.1 BY MEASUREMENT, and it is the precondition for every state diff.
#
# THE PROBLEM. The in-game timer ran on wall-clock milliseconds (getTotalPlayTime), so
# VM_VAR_SECONDS/MINUTES/HOURS/DAYS (vars 11-14) depended on host speed, and any LOGIC value
# derived from them inherited that. Measured on kq4dem, unmodified oracle, 20 s, idle run vs
# a run under 3x-nproc load: vars 11, 72 and 73 diverge (first at cycles 38, 39, 39).
# 11 is the clock; 72 and 73 are kq4dem script values that track it. This reproduces the
# P0.3 finding exactly and explains it.
#
# ★ TWO IDLE RUNS DO NOT SHOW THIS. On an unloaded machine the pacing gate keeps cycle N
# pinned to wall time N/40 and the pair is byte-identical, which looks like determinism and is
# not. THE LOAD IS WHAT MAKES THE COUPLING OBSERVABLE. A determinism check run only on an idle
# machine cannot fail and therefore establishes nothing (backlog L-23).
#
# THE FIX, AND WHY IT IS NOT AN EXCLUSION LIST. The obvious move is to exclude 11/72/73 from
# the diff. That is wrong: 72 and 73 are ordinary game variables, and excluding them puts real
# interpreter state permanently outside the gate to work around a harness defect. Patch 0005
# instead removes the nondeterminism at source -- a virtual clock advancing 25 ms per main-loop
# iteration, which is the unit the pacing gate already counts in.
#
# RESULT, same idle-vs-loaded comparison, 807 common cycles:
#   ALL 256 vars and ALL 256 flags identical. Exclusion set: EMPTY.
#
# ★ AND THE FAILURE MODE IS STILL REACHABLE, so that is a result and not a vacuum: over the
# run var 11 takes 22 distinct values (72 and 73 track it), and the live surface -- state that
# actually changes -- is 6 vars {0,11,30,70,72,73} and 3 flag bytes {0,5,28}.
#
# ★★ §2.1 STATUS: patch 0005 is a DEVIATION FROM THE ORACLE, adopted for determinism. It is
# NOT a claim about Sierra's interpreter. It happens to sit closer to the CoCo3 target, whose
# clock will be a 60 Hz VBL count rather than a host clock, but that is a convenience, not the
# justification. It is the only patch that changes existing behaviour.
#
# ★ RNG. Common::RandomSource seeds from the time of day unless ConfMan has "random_seed"
# (common/random.cpp:42-54), and --random-seed=N is a first-class CLI option
# (base/commandLine.cpp:187,932). Runs pass --random-seed so a game that calls the random
# opcode is deterministic too. NOT YET MEASURED: whether kq4dem consumes the RNG at all.
# The algorithm, if it ever has to be reproduced: xorshift (>>13, <<21, >>11) then
# (seed * 0xDEADBF03) % (max+1).


# ★ SECONDARY SET — NOT FETCHED. Sierra's own DEMOPACK1/2/3 from agi.sierrahelp.com were
# optional this task (dispatch §3) and were skipped: the primary corpus covers every AC,
# including the v3 path, so the fetch bought nothing this task. ★ They remain the nearest
# available fidelity reference for KQ3 and LSL1 — THE TWO TITLES SIERRA SHIPPED FOR THE CoCo3 —
# and are worth having before any fidelity comparison is attempted.
