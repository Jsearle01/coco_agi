 	setTotalPlayTime(newPlayTime);
+	g_oracleVirtualMs = newPlayTime; // coco_agi P4.1: keep the virtual clock consistent
 	inGameTimerResetPassedCycles();
 }
 void AgiEngine::inGameTimerResetPassedCycles() {
 	_passedPlayTimeCycles = 0;
 }
