 namespace Agi {
 
+// coco_agi ORACLE INSTRUMENTATION (P5.1) -- decoded VIEW cel dump.
+//
+// Emitted AFTER decodeView() has fully decoded a view, so what lands is the oracle's own
+// rawBitmap: RLE expanded, mirroring already applied, one byte per pixel. That is exactly the
+// buffer tools/agivm/view.py must reproduce.
+//
+// Two files, because hashes alone cannot localise a mismatch and raw bytes alone cannot be
+// summarised:
+//   cels.txt  one line per cel: view loop cel width height clearKey mirrored blobOffset
+//   cels.bin  the concatenated pixel buffers, at the offsets the manifest names
+//
+// ★ Neither is ever committed (CLAUDE.md §2P): a decoded cel is copyrighted game content. They
+// live in the run's output directory and the report carries counts and hashes only.
+// ★★ GATED, LIKE THE SWEEP IN agi.cpp, AND FOR A MEASURED REASON. Gating only the sweep was
+// tried first and was not enough: with the sweep off but this dump still firing for the views
+// the game loads normally, Kingquest1 STILL diverged from the pre-0006 baseline at cycle 185.
+// The whole patch has to be inert unless asked for, so the gate is here too.
+static void oracleDumpCel(int16 viewNr, int16 loopNr, int16 celNr, const AgiViewCel *cel) {
+	if (!(ConfMan.hasKey("coco_view_sweep") && ConfMan.getBool("coco_view_sweep")))
+		return;
+
+	static Common::DumpFile s_celManifest;
+	static Common::DumpFile s_celBlob;
+	static uint32 s_blobOffset = 0;
+
+	if (!s_celManifest.isOpen()) {
+		if (!s_celManifest.open(Common::Path("cels.txt")))
+			return;
+	}
+	if (!s_celBlob.isOpen()) {
+		if (!s_celBlob.open(Common::Path("cels.bin")))
+			return;
+	}
+
+	uint32 size = (uint32)cel->width * (uint32)cel->height;
+
+	Common::String line = Common::String::format("%d %d %d %d %d %d %d %u\n",
+		viewNr, loopNr, celNr, cel->width, cel->height,
+		cel->clearKey, cel->mirrored ? 1 : 0, s_blobOffset);
+	s_celManifest.write(line.c_str(), line.size());
+	s_celManifest.flush();
+
+	s_celBlob.write(cel->rawBitmap, size);
+	s_celBlob.flush();
+	s_blobOffset += size;
+}
