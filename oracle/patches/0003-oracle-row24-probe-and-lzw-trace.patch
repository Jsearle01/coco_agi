 #include "common/random.h"
 #include "common/system.h"
+#include "common/file.h" // coco_agi ORACLE (P0.3): Common::DumpFile
 #include "common/textconsole.h"
 
 namespace Agi {
 
+// coco_agi ORACLE INSTRUMENTATION (P0.3, AC-7) -- THE ROW-24 PROBE.
+//
+// ★★ WHY THIS EXISTS. Design AD-01 fixes the CoCo3 display at 192 lines: 8 status + 168 play
+// leaves 16 px = TWO 8-px text rows (22, 23), against AGI's THREE (22, 23, 24). So row 24 is
+// the row the port cannot render, and the question is how often games actually address it.
+//
+// ★ P0.2 established from the code that FOUR mechanisms can reach row 24, and that ALL FOUR
+// take the row from GAME DATA rather than from the engine -- so the answer is a property of
+// the corpus and cannot be read out of ScummVM. This probe measures it.
+//
+// ★ IT IS A LOWER BOUND, BY CONSTRUCTION. Games are booted to their first interactive cycle
+// only, so this observes what happens BEFORE the player does anything. A game that addresses
+// row 24 in a death message or an endgame will not be seen here. Never quote the result as a
+// ceiling.
+//
+// text.screen is logged separately because it is UNCONDITIONAL -- it always clears 0..24, so
+// it says "this game uses the full 25-row text screen", not "this game placed text at 24".
+static void oracleRow24(const char *mechanism, int16 row) {
+	if (row <= 23)
+		return;
+	static Common::DumpFile s_log;
+	if (!s_log.isOpen()) {
+		if (!s_log.open(Common::Path("row24.txt")))
+			return;
+	}
+	Common::String line = Common::String::format("%s row=%d\n", mechanism, row);
+	s_log.write(line.c_str(), line.size());
+	s_log.flush();
+}
