+// coco_agi ORACLE INSTRUMENTATION (P0.2) -- see graphics.h.
+//
+// Emits the two 160x168 buffers as RAW BYTES, one file each, exactly as the engine
+// holds them: _pixels == SCRIPT_WIDTH * SCRIPT_HEIGHT == 26880, flat row-major, one
+// byte per pixel. NO transformation, NO scaling, NO palette application. The display
+// path (_displayScreen, 320x200 or 640x400) is deliberately NOT dumped -- it is a
+// rendering of these buffers, and diffing against a rendering would put ScummVM's
+// upscaler inside our baseline.
+//
+// Files land in the process working directory so the runner controls placement
+// without an env var: ScummVM's forbidden-symbol policy rules out getenv/fopen, and
+// Common::DumpFile is the sanctioned writer.
+void GfxMgr::oracleDumpScreens(int16 resourceNr) const {
+	if (_gameScreen == nullptr || _priorityScreen == nullptr)
+		return;
+
+	const struct { const char *suffix; const byte *buffer; } dumps[] = {
+		{ "visual",   _gameScreen     },
+		{ "priority", _priorityScreen }
+	};
+
+	for (int i = 0; i < 2; i++) {
+		Common::String name = Common::String::format("pic%03d.%s.bin", resourceNr, dumps[i].suffix);
+		Common::DumpFile df;
+		if (!df.open(Common::Path(name))) {
+			warning("oracleDumpScreens: could not open %s", name.c_str());
+			continue;
+		}
+		df.write(dumps[i].buffer, _pixels);
+		df.finalize();
+		df.close();
+	}
+}
