+// coco_agi ORACLE INSTRUMENTATION (P1.1, AC-5) -- dump the RAW bytes the engine loads.
+//
+// ★★ THIS IS THE BASELINE OUR PYTHON PARSER IS DIFFED AGAINST (CLAUDE.md §2O.1). The whole
+// value is that these bytes did not come from us. So the dump is taken at exactly one point:
+// immediately after loadVolumeResource() returns and BEFORE any decode.
+//
+// ★ FOR LOGIC THAT ORDERING IS NOT A DETAIL, IT IS THE WHOLE THING. decodeLogic() DECRYPTS THE
+// MESSAGE STRINGS IN PLACE. Dumping after it would compare our pre-decode bytes against their
+// post-decode bytes and fail everywhere -- or worse, would tempt someone to "fix" the parser to
+// match, which inverts the validation exactly as tuning to POP's 59 would have.
+static void oracleDumpRaw(int16 resourceType, int16 resourceNr, const uint8 *data, uint32 len) {
+	if (data == nullptr)
+		return;
+	// ★★ INDEXED BY THE REAL ENUM, WHICH STARTS AT 1 AND IS NOT IN THE OBVIOUS ORDER.
+	// agi.h:171-174:  RESOURCETYPE_LOGIC = 1, SOUND = 2, VIEW = 3, PICTURE = 4.
+	// An earlier version of this array assumed {logic,object,view,picture,sound} from 0 and
+	// mislabelled EVERY dump -- LOGIC written as "object", PICTURE compared against VIEW.
+	// The gate then read 0 of 299 matching and looked like a parser failure. Read the enum.
+	static const char *kNames[] = { "other", "logic", "sound", "view", "picture" };
+	const char *nm = (resourceType >= 1 && resourceType <= 4) ? kNames[resourceType] : "other";
+	Common::String path = Common::String::format("oracle_%s_%03d.bin", nm, resourceNr);
+	Common::DumpFile df;
+	if (!df.open(Common::Path(path)))
+		return;
+	df.write(data, len);
+	df.finalize();
+	df.close();
+}
