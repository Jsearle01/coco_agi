 //		warning("sprite %d (view %d), priority %d, sort %d, givenOrder %d", screenObj->objectNr, screenObj->currentView, screenObj->priority, sprite.sortOrder, sprite.givenOrderNr);
 		drawCel(screenObj);
 	}
+	if (oracleDumping)
+		oracleDumpFrame("after", oracleFrameNr);
 }
 
