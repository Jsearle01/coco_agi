+void GfxMgr::oracleLogText(const char *kind, int a, int b, int c, int d, int e) {
+	if (!oracleTextDumpEnabled())
+		return;
+	// ??????????????? A STATIC HANDLE, HELD OPEN -- patch 0002's s_vmLog pattern, and the first version of
+	// this did not follow it. Common::DumpFile::open's second parameter is createPath, NOT append
+	// (common/file.h), so open-write-close per event TRUNCATES on every call and the file ends up
+	// holding one line or none. **The order of these events is the artifact**, so the handle stays
+	// open for the process and the stream is flushed per line.
+	static Common::DumpFile s_textLog;
+	if (!s_textLog.isOpen()) {
+		if (!s_textLog.open(Common::Path("text_events.txt")))
+			return;
+	}
+	Common::String line = Common::String::format("%s %d %d %d %d %d\n", kind, a, b, c, d, e);
+	s_textLog.write(line.c_str(), line.size());
+	// ??? Flushed per line for the reason patch 0002 flushes: the run is killed on a wall-clock
+	// timeout, so anything sitting in a buffer at the kill is lost and the log silently truncates.
+	s_textLog.flush();
+}
